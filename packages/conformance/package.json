{
  "name": "@dtp/conformance",
  "version": "0.1.0",
  "description": "dtp-wot/1 corpus runner, fixture helpers, and telemetry contract checks",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-extensions.mjs dist"
  },
  "dependencies": {
    "@dtp/trust-graph": "0.1.0",
    "@dtp/trust-protocol": "0.1.0",
    "@dtp/trust-query": "0.1.0"
  }
}
