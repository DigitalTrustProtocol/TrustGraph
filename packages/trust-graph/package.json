{
  "name": "@dtp/trust-graph",
  "version": "0.1.0",
  "description": "WoT heap: Graph, Node, Edge, IndexResolver, Score (from DigitalTrustProtocol/Trust via AttentionX; divergences in DIVERGENCE.json)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./threshold": {
      "types": "./dist/threshold.d.ts",
      "import": "./dist/threshold.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "divergence:check": "node ../../scripts/trust-graph-divergence.mjs"
  }
}
