root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Vendored heap: keep bytes identical to AttentionX/src/graph/trust.
[packages/trust-graph/src/{Graph,IndexResolver,Node,Edge,Score,pathStrategyJson,IResolveStrategy,types,index}.ts]
trim_trailing_whitespace = false
insert_final_newline = unset
