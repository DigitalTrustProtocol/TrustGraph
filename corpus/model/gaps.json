{
  "cases": [
    {
      "id": "gap-g1-rating-context-falls-back",
      "model": "dtp-wot/1",
      "tags": ["rating", "context"],
      "profile": "x.com",
      "description": "NIP-32014 'no fallback': a rating query for c=identity must not see an empty-context rating. Fixed gap G1: the heap used to fall back to the global bucket.",
      "records": [
        { "id": "@g1-rate", "pubkey": "@root", "kind": 32014, "created_at": 1, "subjectType": "i", "subject": "post:id:42", "value": 70, "scopeRank": 2 }
      ],
      "queries": [
        {
          "type": "rating",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "post:id:42" }, "context": "identity", "now": 10 },
          "expect": { "claimCount": 0, "degree": 0 }
        }
      ]
    },
    {
      "id": "gap-g2-first-inserted-slot-wins",
      "model": "dtp-wot/1",
      "tags": ["walk", "slot"],
      "profile": "x.com",
      "description": "One author has an empty-scope slot and an x.com slot about the same node in one bucket. P2: higher scopeRank wins. Fixed gap G2: the first inserted record used to win.",
      "records": [
        { "addressKey": "32009:@root:empty-scope", "id": "@g2-empty", "pubkey": "@root", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@bob", "context": "identity", "value": -1, "scopeRank": 1 },
        { "addressKey": "32009:@root:xcom-scope", "id": "@g2-xcom", "pubkey": "@root", "kind": 32009, "created_at": 5, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1, "scopeRank": 2 }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@bob" }, "context": "identity", "now": 20 },
          "expect": { "trust": 1, "distrust": 0, "resolution": "trusted", "sourceEventIds": ["@g2-xcom"] }
        }
      ]
    },
    {
      "id": "gap-g3-delete-unlinks-sibling-slot",
      "model": "dtp-wot/1",
      "tags": ["slot", "delete"],
      "profile": "x.com",
      "description": "A Delete in the empty-scope slot affects only its own slot (fixed gap G3: the heap used to unlink every same-kind record from that author to that node in the bucket with created_at <= the Delete).",
      "ops": [
        { "op": "apply", "record": { "addressKey": "32009:@root:empty-scope", "id": "@g3-empty", "pubkey": "@root", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1, "scopeRank": 1 } },
        { "op": "apply", "record": { "addressKey": "32009:@root:xcom-scope", "id": "@g3-xcom", "pubkey": "@root", "kind": 32009, "created_at": 20, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1, "scopeRank": 2 } },
        { "op": "apply", "record": { "addressKey": "32009:@root:empty-scope", "id": "@g3-delete", "pubkey": "@root", "kind": 32009, "created_at": 30, "subjectType": "p", "subject": "@bob", "context": "identity", "scopeRank": 1 } }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@bob" }, "context": "identity", "now": 40 },
          "expect": { "connected": true, "trust": 1, "sourceEventIds": ["@g3-xcom"] }
        }
      ]
    },
    {
      "id": "gap-g4-disconnected-neutral-leak",
      "model": "dtp-wot/1",
      "tags": ["walk", "neutral"],
      "profile": "x.com",
      "description": "The root's only statement about Alice is Neutral. D4 option A: disconnected carries no statements and neutral 0. Fixed gaps G4 and G7: the Neutral used to leak, counted twice because the subject shared its counters with its peer score.",
      "source": "AttentionX src/graph/graph.test.ts (keeps a direct Neutral without connecting)",
      "records": [
        { "id": "@g4-root-alice", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 0 }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@alice" }, "context": "identity", "now": 10 },
          "expect": { "connected": false, "degree": 0, "neutral": 0, "trust": 0, "statements": [] }
        }
      ]
    },
    {
      "id": "gap-g5-web-subject-case",
      "model": "dtp-wot/1",
      "tags": ["walk", "gap:G5"],
      "profile": "x.com",
      "description": "Two web: subjects that differ only in path case are different artifacts. Today every node key is lowercased, so they collide.",
      "records": [
        { "id": "@g5-root-alice", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 },
        { "id": "@g5-root-bob", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 },
        { "id": "@g5-upper", "pubkey": "@alice", "kind": 32009, "created_at": 2, "subjectType": "i", "subject": "web:https://example.com/Report", "value": 1 },
        { "id": "@g5-lower", "pubkey": "@bob", "kind": 32009, "created_at": 1, "subjectType": "i", "subject": "web:https://example.com/report", "value": -1 }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "web:https://example.com/Report" }, "now": 10 },
          "expectModel": { "trust": 1, "distrust": 0, "sourceEventIds": ["@g5-upper"] },
          "expectCurrent": { "trust": 1, "distrust": 1, "sourceEventIds": ["@g5-upper", "@g5-lower"] }
        }
      ]
    },
    {
      "id": "gap-g10-node-budget",
      "model": "dtp-wot/1",
      "tags": ["walk", "budget"],
      "profile": "x.com",
      "description": "wot-model.md §6.2 with maxReachedNodes 2 (the root counts; only p nodes get levels). Level 1 {alice} fits (2 nodes); building level 2 would reach bob (3 > 2), so the walk stops with completeDepth 1. No hit up to degree 2, so the result is disconnected and truncated. Fixed gap G10: the walk used to have no budgets.",
      "records": [
        { "id": "@g10-r-a", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 },
        { "id": "@g10-a-b", "pubkey": "@alice", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 },
        { "id": "@g10-b-t", "pubkey": "@bob", "kind": 32009, "created_at": 1, "subjectType": "i", "subject": "user:id:77", "context": "identity", "value": 1 }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:77" }, "context": "identity", "now": 10, "budgets": { "maxReachedNodes": 2 } },
          "expect": { "connected": false, "degree": 0, "truncated": true, "truncatedReasons": ["nodeBudget"], "completeDepth": 1 }
        }
      ]
    },
    {
      "id": "gap-g10-record-budget",
      "model": "dtp-wot/1",
      "tags": ["walk", "budget"],
      "profile": "x.com",
      "description": "wot-model.md 6.2 scanned-record counting. Building level 1 scans the root's two selected statements (alice, and the post, which is scanned but not a hop): 2 records. Building level 2 scans alice's statement about bob: 3 in total. Hit checks are not counted. With maxWalkRecords 2 level 2 does not fit (completeDepth 1, edgeBudget); with 3 it fits and the hit at degree 3 is exact and not truncated. Fixed gap G10: the walk used to have no budgets.",
      "records": [
        { "id": "@g10r-r-a", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 },
        { "id": "@g10r-r-post", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "i", "subject": "post:id:5", "context": "identity", "value": 1 },
        { "id": "@g10r-a-b", "pubkey": "@alice", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 },
        { "id": "@g10r-b-t", "pubkey": "@bob", "kind": 32009, "created_at": 1, "subjectType": "i", "subject": "user:id:77", "context": "identity", "value": 1 }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:77" }, "context": "identity", "now": 10, "budgets": { "maxWalkRecords": 2 } },
          "expect": { "connected": false, "degree": 0, "truncated": true, "truncatedReasons": ["edgeBudget"], "completeDepth": 1 }
        },
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:77" }, "context": "identity", "now": 10, "budgets": { "maxWalkRecords": 3 } },
          "expect": { "connected": true, "degree": 3, "sourceEventIds": ["@g10r-b-t"], "completeDepth": null }
        }
      ]
    }
  ]
}
