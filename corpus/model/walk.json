          "expect": { "resolution": "trusted", "followTrustThreshold": 60, "followTrustRed": 25 }
        },
        {
          "type": "trust",
          "note": "Red above the share: distrusted band only when percent < red.",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:42" }, "context": "identity", "now": 10, "followTrustThreshold": 90, "followTrustRed": 70 },
          "expect": { "resolution": "distrusted", "followTrustThreshold": 90, "followTrustRed": 70 }
        }
