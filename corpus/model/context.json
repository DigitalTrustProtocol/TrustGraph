            "resolution": "distrusted", "trust": 0, "distrust": 1,
            "direct": { "eventId": "@c-security", "context": "security", "requestedContext": "security:audit", "contextMatch": "parent", "value": -1 }
          }
        },
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "post:id:42" }, "context": "", "now": 10 },
          "expect": { "resolution": "trusted", "direct": { "eventId": "@c-general", "contextMatch": "exact" } }
        }
      ]
    },
