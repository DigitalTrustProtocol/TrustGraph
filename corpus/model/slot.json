{
  "cases": [
    {
      "id": "slot-newer-replaces-older-discarded",
      "model": "dtp-wot/1",
      "tags": ["slot"],
      "profile": "x.com",
      "source": "AttentionX src/graph/graph.test.ts (replacement updates)",
      "ops": [
        { "op": "apply", "record": { "addressKey": "32009:@root:slot-a", "id": "@s-middle", "pubkey": "@root", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 } },
        { "op": "apply", "record": { "addressKey": "32009:@root:slot-a", "id": "@s-older", "pubkey": "@root", "kind": 32009, "created_at": 9, "subjectType": "p", "subject": "@bob", "context": "identity", "value": -1 } }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@bob" }, "context": "identity", "now": 20 },
          "expect": { "trust": 1, "distrust": 0, "direct": { "eventId": "@s-middle" } }
        }
      ]
    },
    {
