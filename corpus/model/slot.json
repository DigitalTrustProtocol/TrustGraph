    {
      "id": "slot-delete-winner-keeps-older-out",
      "model": "dtp-wot/1",
      "tags": ["slot", "delete"],
      "profile": "x.com",
      "source": "AttentionX src/graph/bind-identity.test.ts (tombstones)",
      "ops": [
        { "op": "apply", "record": { "addressKey": "32009:@root:slot-a", "id": "@s-live", "pubkey": "@root", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 } },
        { "op": "apply", "record": { "addressKey": "32009:@root:slot-a", "id": "@s-delete", "pubkey": "@root", "kind": 32009, "created_at": 20, "subjectType": "p", "subject": "@bob", "context": "identity" } },
        { "op": "apply", "record": { "addressKey": "32009:@root:slot-a", "id": "@s-stale", "pubkey": "@root", "kind": 32009, "created_at": 15, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 } }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@bob" }, "context": "identity", "now": 30 },
          "expect": { "connected": false, "statements": [] }
        },
        {
          "type": "lookup-incoming",
          "note": "Delete winners never appear in lookups.",
          "input": { "keys": ["p:@bob"], "context": "identity", "mode": "raw", "includeInactive": true, "now": 30 },
          "expect": { "items": [] }
        }
      ]
    },
