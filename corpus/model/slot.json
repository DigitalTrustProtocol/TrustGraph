        { "op": "apply", "record": { "addressKey": "32009:@root:slot-a", "id": "@s-live", "pubkey": "@root", "kind": 32009, "created_at": 30, "subjectType": "p", "subject": "@bob", "context": "identity", "value": -1 } }
      ],
