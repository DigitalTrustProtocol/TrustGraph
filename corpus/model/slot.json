    {
      "id": "slot-apply-twice-is-idempotent",
      "model": "dtp-wot/1",
      "tags": ["slot", "property:idempotence"],
      "profile": "x.com",
      "ops": [
        { "op": "apply", "record": { "id": "@s1", "pubkey": "@root", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 } },
        { "op": "apply", "record": { "id": "@s2", "pubkey": "@alice", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 } },
        { "op": "apply", "record": { "id": "@s1", "pubkey": "@root", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 } },
        { "op": "apply", "record": { "id": "@s2", "pubkey": "@alice", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 } }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@bob" }, "context": "identity", "now": 20 },
          "expect": { "connected": true, "degree": 2, "trust": 1, "statements": [{ "eventId": "@s2" }] }
        },
        {
          "type": "lookup-incoming",
          "input": { "keys": ["p:@bob"], "context": "identity", "mode": "raw", "now": 20 },
          "expect": { "items": ["@s2"] }
        }
      ]
    },
    {
      "id": "slot-remove-op",
      "model": "dtp-wot/1",
      "tags": ["slot"],
      "profile": "x.com",
      "ops": [
        { "op": "apply", "record": { "id": "@s1", "pubkey": "@root", "kind": 32009, "created_at": 10, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 } },
        { "op": "remove", "addressKey": "32009:@root:p:@alice:identity" }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@alice" }, "context": "identity", "now": 20 },
          "expect": { "connected": false }
        }
      ]
    }
