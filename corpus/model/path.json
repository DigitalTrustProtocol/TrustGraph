      "model": "dtp-wot/1",
      "tags": ["path"],
      "profile": "x.com",
      "source": "AttentionX src/graph/graph.test.ts (reconstructs every hop on a degree-4 path)",
      "records": [
        { "id": "@p-r-a", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 },
        { "id": "@p-a-b", "pubkey": "@alice", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 },
        { "id": "@p-b-c", "pubkey": "@bob", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@carol", "context": "identity", "value": 1 },
        { "id": "@p-c-t", "pubkey": "@carol", "kind": 32009, "created_at": 1, "subjectType": "i", "subject": "user:id:4", "context": "identity", "value": 1 }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:4" }, "context": "identity", "now": 10, "format": "path" },
          "expect": {
            "connected": true, "degree": 4,
            "pathView": {
              "nodes": [
                { "subject": "p:@root", "depth": 0 },
                { "subject": "p:@alice", "depth": 1 },
                { "subject": "p:@bob", "depth": 2 },
                { "subject": "p:@carol", "depth": 3 },
                { "subject": "i:user:id:4", "depth": 4 }
              ],
              "edges": [
                { "eventId": "@p-r-a", "from": "p:@root", "to": "p:@alice", "value": 1 },
                { "eventId": "@p-a-b", "from": "p:@alice", "to": "p:@bob", "value": 1 },
                { "eventId": "@p-b-c", "from": "p:@bob", "to": "p:@carol", "value": 1 },
                { "eventId": "@p-c-t", "from": "p:@carol", "to": "i:user:id:4", "value": 1 }
              ]
            }
          }
        },
        {
          "type": "trust",
          "note": "format default carries no path.",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:4" }, "context": "identity", "now": 10 },
          "expect": { "connected": true, "degree": 4, "pathView": { "nodes": [], "edges": [] } }
        }
      ]
    },
