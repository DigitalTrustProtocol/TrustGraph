{
  "cases": [
    {
      "id": "threshold-mixed-hop",
      "model": "dtp-wot/1",
      "tags": ["walk", "threshold"],
      "profile": "x.com",
      "source": "AttentionX src/graph/follow-trust-threshold.test.ts",
      "description": "Carol is reached at level 2 with one trust and one distrust (50 %). She is a hop only when the threshold is at most 50.",
      "records": [
        { "id": "@t-root-alice", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@alice", "context": "identity", "value": 1 },
        { "id": "@t-root-bob", "pubkey": "@root", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@bob", "context": "identity", "value": 1 },
        { "id": "@t-alice-carol", "pubkey": "@alice", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@carol", "context": "identity", "value": 1 },
        { "id": "@t-bob-carol", "pubkey": "@bob", "kind": 32009, "created_at": 1, "subjectType": "p", "subject": "@carol", "context": "identity", "value": -1 },
        { "id": "@t-carol-x", "pubkey": "@carol", "kind": 32009, "created_at": 1, "subjectType": "i", "subject": "user:id:500", "context": "identity", "value": 1 }
      ],
      "queries": [
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:500" }, "context": "identity", "now": 10 },
          "expect": { "connected": false, "degree": 0, "followTrustThreshold": 75 }
        },
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:500" }, "context": "identity", "now": 10, "followTrustThreshold": 50, "followTrustRed": 25 },
          "expect": { "connected": true, "degree": 3, "trust": 1, "statements": [{ "eventId": "@t-carol-x", "author": "@carol", "distance": 2 }] }
        },
        {
          "type": "trust",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "user:id:500" }, "context": "identity", "now": 10, "followTrustThreshold": 51 },
          "expect": { "connected": false }
        },
        {
          "type": "trust",
          "note": "Carol's own score: evidence from both level-1 authors.",
          "input": { "rootPubkey": "@root", "subject": { "type": "p", "value": "@carol" }, "context": "identity", "now": 10 },
          "expect": { "connected": true, "degree": 2, "trust": 1, "distrust": 1, "resolution": "mixed" }
        }
      ]
    },
