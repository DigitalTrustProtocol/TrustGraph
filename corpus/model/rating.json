        { "id": "@genuine", "pubkey": "@alice", "kind": 32014, "created_at": 1, "subjectType": "i", "subject": "post:id:42", "value": 100, "labels": ["genuine"], "labelHints": { "genuine": "Looks like a real person" }, "scopeRank": 2 },
        { "id": "@spam", "pubkey": "@carol", "kind": 32014, "created_at": 1, "subjectType": "i", "subject": "post:id:42", "value": 0, "labels": ["spam"], "scopeRank": 2 }
      ],
      "queries": [
        {
          "type": "rating",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "post:id:42" }, "now": 10 },
          "expect": { "claimCount": 1, "degree": 2, "claims": [{ "eventId": "@genuine", "labels": ["genuine"], "labelHints": { "genuine": "Looks like a real person" } }] }
        },
        {
          "type": "rating",
          "note": "The label filter empties the hitting degree; the walk does not continue to Carol.",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "post:id:42" }, "labels": ["spam"], "now": 10 },
          "expect": { "claimCount": 0, "degree": 0, "averageScore": null, "claims": [] }
        },
        {
          "type": "rating",
          "note": "Label hints are display text, never filter input.",
          "input": { "rootPubkey": "@root", "subject": { "type": "i", "value": "post:id:42" }, "labels": ["Looks like a real person"], "now": 10 },
          "expect": { "claimCount": 0 }
        }
